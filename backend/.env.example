# NiuGymFree Backend Server Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Cloud Database Configuration
# Obtain these from your Supabase project dashboard: Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local Authentication & Session Secrets
JWT_SECRET=super-secret-niugymfree-jwt-key-change-in-production
